# ─────────────────────────────────────────────────────────────────────────────
# 24×7 WhatsApp Customer Requirement Automation System — Environment Config
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="WhatsApp Requirement Automation System"
ENVIRONMENT=production
DEBUG=false
PORT=8080
HOST=0.0.0.0

# Timezone (All business timestamps formatted in IST)
TIMEZONE=Asia/Kolkata

# Database URL
# For local SQLite: sqlite:///./data/whatsapp_production.db
# For production PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./data/whatsapp_production.db

# WhatsApp Provider: "meta_cloud", "local_web", or "mock"
WHATSAPP_PROVIDER=meta_cloud

# Meta WhatsApp Cloud API Credentials
# Get these free from https://developers.facebook.com
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=whatsapp_verify_token_2026

# Message Burst Debounce (Seconds of silence to wait after typing before replying)
DEBOUNCE_SECONDS=1.5

# Business Rules
REQUIRE_GST_MANDATORY=false
